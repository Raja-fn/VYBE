{
  "name": "vybe-server",
  "private": true,
  "engines": {
    "node": "22"
  },
  "scripts": {
    "sync-config": "node scripts/sync-config.mjs",
    "typecheck": "npm run sync-config && tsc --noEmit -p .",
    "test": "npm run sync-config && jest",
    "test:db": "npm run sync-config && jest --config jest.db.config.js",
    "build:edge": "npm run sync-config && node scripts/build-edge.mjs",
    "seed": "npm run sync-config && tsx seed/seed.ts",
    "smoke:edge": "tsx scripts/edge-smoke.ts"
  },
  "dependencies": {
    "postgres": "^3.4.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "deno": "^2.9.6",
    "embedded-postgres": "^17.5.0-beta.15",
    "esbuild": "^0.25.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
